cabal-version: 3.0
name:          blatherings
version:       0.1.0.0
synopsis:      Generator for words.chreekat.net
author:        Bryan Richter
maintainer:    b@chreekat.net
license:       NONE
build-type:    Simple

common shared
    default-language: GHC2021
    ghc-options:      -Wall

library
    import:          shared
    hs-source-dirs:  src
    exposed-modules:
        Blatherings
        Blatherings.Hits
    build-depends:
        aeson,
        base,
        bytestring,
        containers,
        crypton,
        filepath,
        memory,
        network-uri,
        text,
        time

executable site
    import:         shared
    hs-source-dirs: app
    main-is:        Site.hs
    ghc-options:    -threaded -rtsopts
    build-depends:
        aeson,
        base,
        blatherings,
        filepath,
        hakyll,
        pandoc,
        pandoc-types,
        time

executable hits
    import:         shared
    hs-source-dirs: app
    main-is:        Hits.hs
    build-depends:
        base,
        blatherings,
        bytestring

test-suite spec
    import:         shared
    type:           exitcode-stdio-1.0
    hs-source-dirs: test
    main-is:        Main.hs
    other-modules:  HitsSpec
    build-depends:
        base,
        blatherings,
        bytestring,
        tasty,
        tasty-hunit,
        time
